# Database
DATABASE_URL=postgresql+asyncpg://placement_user:placement_pass@localhost:5432/placement_portal

# Security
SECRET_KEY=change-this-to-a-64-character-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
LLM_PROVIDER=google
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.0-flash

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000

# File Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads

# Agent Config
MAX_RETRIES=3
TOKEN_BUDGET=100000
RUN_TIMEOUT_SECONDS=300
